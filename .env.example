# 网站正式地址（分享卡片、搜索引擎用）。GitHub Pages 构建时由 CI 自动设置
NEXT_PUBLIC_SITE_URL=https://liyucheng1997.github.io/351_lab-factory-website
# 子路径（GitHub Pages 项目站点 = /仓库名）。绑定自己的域名后留空
NEXT_PUBLIC_BASE_PATH=

# 询价表单的接收地址（静态网站没有服务器，用 Formspree / Getform 之类的表单服务，免费版就够）
# 例：https://formspree.io/f/abcdwxyz 。不填时，表单会打开访客自己的邮件程序，发到 company.ts 里的 email
NEXT_PUBLIC_FORM_ENDPOINT=
